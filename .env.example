# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

SECRET_KEY=gere-com-get_random_secret_key
DEBUG=True

# --- MySQL local (MySQL Workbench) ---
# Sem estas linhas, o projeto usa o SQLite (db.sqlite3)
DB_NAME=nexar
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_HOST=localhost
DB_PORT=3307   # muda por máquina: 3307 numa, 3306 noutra (veja a porta do seu MySQL)

# --- Supabase (só na Vercel; NÃO deixe ativo no seu .env) ---
# Quando existe, ganha do MySQL. Pegue em Supabase > Connect > "Transaction pooler"
# DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-us-west-2.pooler.supabase.com:6543/postgres
# SSL da conexão PostgreSQL (padrão: require, o que o Supabase exige).
# Use disable apenas num PostgreSQL local de teste (ex.: container Docker).
# DB_SSLMODE=require
# MEDIA_URL=/static/img/

# --- Migrar os dois bancos de uma vez: python manage.py migrar_tudo ---
# Mesma URL do Supabase, mas com outro nome: assim o site local continua no MySQL
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-us-west-2.pooler.supabase.com:6543/postgres
